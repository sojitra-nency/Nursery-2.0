# Sanity (public — safe to expose in browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity Studio (same values as above)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_ORGANIZATION_ID=
SANITY_STUDIO_DATASET=production

# Sanity server-only secrets
SANITY_API_READ_TOKEN=
SANITY_API_EDIT_TOKEN=
SANITY_REVALIDATE_SECRET=

# Content translation (scripts/translate-content.mjs) — all options are free.
# Leave unset to use the keyless MyMemory fallback (poor quality on Indic pairs).
#   gemini   → aistudio.google.com, no credit card. Best quality; set GEMINI_API_KEY.
#   bhashini → bhashini.gov.in (Govt. of India, IndicTrans2). Set all three below.
TRANSLATE_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_KEY=
